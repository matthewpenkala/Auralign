<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>@@PRODUCT_NAME@@</title>
  <options customize="never" require-scripts="false"/>

  <!--
    Installer renders these behind its own native, localized interface.
    The resources deliberately contain no text or simulated controls.
  -->
  <background
    file="background.png"
    alignment="bottomleft"
    scaling="tofit"/>
  <background-darkAqua
    file="background-darkAqua.png"
    alignment="bottomleft"
    scaling="tofit"/>

  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>

  <choices-outline>
    <line choice="default"/>
  </choices-outline>
  <choice
    id="default"
    title="@@PRODUCT_NAME@@"
    description="Installs @@PRODUCT_NAME@@ in Applications.">
    <pkg-ref id="@@PACKAGE_ID@@"/>
  </choice>
  <pkg-ref id="@@PACKAGE_ID@@">@@COMPONENT_PACKAGE@@</pkg-ref>
</installer-gui-script>
