<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>@@PRODUCT_NAME@@</title>
  <options customize="never" require-scripts="false"/>

  <!--
    Installer renders these behind its own native, localized interface.
    The resources deliberately contain no text or simulated controls.
  -->
  <background
    file="background.png"
    alignment="bottomleft"
    scaling="tofit"/>
  <background-darkAqua
    file="background-darkAqua.png"
    alignment="bottomleft"
    scaling="tofit"/>

  <welcome file="welcome.html" mime-type="text/html"/>
  <readme file="readme.html" mime-type="text/html"/>
  <license file="license.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>

  <choices-outline>
    <line choice="default">
      <line choice="@@APP_PACKAGE_ID@@"/>
      <line choice="@@MODEL_PACKAGE_ID@@"/>
    </line>
  </choices-outline>
  <choice id="default"/>
  <choice id="@@APP_PACKAGE_ID@@" visible="false">
    <pkg-ref id="@@APP_PACKAGE_ID@@"/>
  </choice>
  <choice id="@@MODEL_PACKAGE_ID@@" visible="false">
    <pkg-ref id="@@MODEL_PACKAGE_ID@@"/>
  </choice>
  <pkg-ref id="@@APP_PACKAGE_ID@@">@@APP_COMPONENT_PACKAGE@@</pkg-ref>
  <pkg-ref id="@@MODEL_PACKAGE_ID@@">@@MODEL_COMPONENT_PACKAGE@@</pkg-ref>
</installer-gui-script>
