# Ignored local caches. GitHub contains model pointers and recipes, not weights.
LTM_MODEL_CACHE=./models
HF_HOME=./.hf-cache
HF_HUB_CACHE=./.hf-cache/hub

# Offline/runtime behavior
LTM_OFFLINE=0
LTM_DEVICE=cpu

# Budget-aware bootstrap defaults
LTM_BOOTSTRAP_PROFILE=runtime-samples
LTM_BOOTSTRAP_MAX_LOCAL_GB=65
LTM_BOOTSTRAP_MIN_FREE_GB=100
LTM_SAMPLE_MAX_GB=1
LTM_ALLOW_OVER_BUDGET=0
LTM_DATASET_CACHE=./datasets

# Optional cloud/object-storage dataset mirror.
# Use a named rclone remote, not inline credentials, for example:
# LTM_DATASET_MIRROR_REMOTE=gdrive:auralign-datasets
LTM_DATASET_MIRROR_REMOTE=

# Local API and speaker-profile storage. Docker Compose maps these to private,
# writable container volumes instead of using these host-relative values.
LTM_API_JOB_STORE=./outputs/api/.job-store
LTM_SPEAKER_PROFILE_DIR=~/.local-transcript-max/speakers

# Non-loopback API binds must set network-bound mode and explicit existing
# roots. The Compose server profile supplies /input and /output; models use a
# separate /models mount.
# LTM_API_NETWORK_BOUND=1
# LTM_API_ALLOWED_INPUT_ROOTS=/absolute/input/root
# LTM_API_ALLOWED_OUTPUT_ROOTS=/absolute/output/root

# Optional local cleanup should use localhost unless explicitly overridden.
LTM_CLEANUP_ENDPOINT=http://127.0.0.1:11434/v1

# Set locally only after accepting gated Hugging Face model terms.
# LTM_HF_TOKEN takes precedence over HF_TOKEN.
# Never commit real tokens.
LTM_HF_TOKEN=
HF_TOKEN=
